--- a/demo/railway/src/schedule.py
+++ b/demo/railway/src/schedule.py
@@ -34,6 +34,15 @@ class Train:
         return stops
 
 
+def adjust_departure(train: Train, new_start: str) -> Train:
+    """按新的始发时刻整表平移，站间运行时分保持不变。"""
+    return Train(
+        train_id=train.train_id,
+        start=new_start,
+        legs=dict(train.legs),
+    )
+
+
 def arrival_times(train: Train) -> dict[str, str]:
     """各站时刻 = 始发时刻 + 累计运行时分。"""
     stops = train.stops()
