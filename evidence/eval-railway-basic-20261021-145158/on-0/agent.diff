+def test_adjusted_train_still_blocked_by_existing_occupation() -> None:
+    """调整发车后与既有车辆占用窗口冲突，仍须禁止发布（REQ-2、REQ-3）。"""
+    # 原时刻 08:00-08:25 与 560-580 不冲突。
+    busy = [Occupation("K1", 560, 580)]
+    ok, _ = can_publish(make_train(), busy)
+    assert ok
+
+    # 平移到 09:00 后，末段 B->C 变为 09:10-09:25，与 09:20-09:40 冲突。
