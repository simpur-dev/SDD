--- /dev/null
+++ b/src/components/AuthorFilter.tsx
@@ -0,0 +1,31 @@
+import { useSearchStore } from '../store/searchStore'
+import styles from './AuthorFilter.module.css'
+
+interface AuthorFilterProps {
+  authors: string[]
+}
+
+export function AuthorFilter({ authors }: AuthorFilterProps) {
+  const { author, setAuthor } = useSearchStore()
+
+  return (
+    <div className={styles.wrapper}>
+      <label className={styles.label} htmlFor="author-select">
+        Author:
+      </label>
+      <select
+        id="author-select"
+        className={styles.select}
+        value={author}
+        onChange={(e) => setAuthor(e.target.value)}
+      >
+        <option value="">All authors</option>
+        {authors.map((name) => (
+          <option key={name} value={name}>
+            {name}
+          </option>
+        ))}
+      </select>
+    </div>
+  )
+}
