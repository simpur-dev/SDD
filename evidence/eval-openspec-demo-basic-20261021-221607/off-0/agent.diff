diff --git a/tests/author-filter.spec.ts b/tests/author-filter.spec.ts
new file mode 100644
index 0000000..abec669
--- /dev/null
+++ b/tests/author-filter.spec.ts
@@ -0,0 +1,110 @@
+import { test, expect } from '@playwright/test'
+import { setupApiMocks } from './helpers/mockApi'
+
+const multiAuthorResponse = {
+  numFound: 60,
+  start: 0,
+  numFoundExact: true,
+  docs: [
+    {
+      key: '/works/OL1W',
+      title: 'Book One',
+      author_name: ['Author A'],
+      author_key: ['OL1A'],
+      cover_i: null,
+      first_publish_year: 2000,
+    },
+    {
+      key: '/works/OL2W',
+      title: 'Book Two',
+      author_name: ['Author B', 'Author C'],
+      author_key: ['OL2A', 'OL3A'],
+      cover_i: null,
+      first_publish_year: 2001,
+    },
+    {
+      key: '/works/OL3W',
+      title: 'Book Three',
+      author_name: ['Author A'],
+      author_key: ['OL1A'],
+      cover_i: null,
+      first_publish_year: 2002,
+    },
+  ],
+}
+
+async function search(page: Parameters<typeof setupApiMocks>[0]) {
+  await page.goto('/')
+  await page.getByRole('searchbox').fill('tolkien')
+  await page.getByRole('button', { name: 'Search' }).click()
+  await expect(page.getByRole('list', { name: 'Search results' })).toBeVisible()
+}
+
+test('author filter lists deduplicated authors from current results', async ({
+  page,
+}) => {
+  await setupApiMocks(page, { searchResponse: multiAuthorResponse })
+  await search(page)
+
+  const select = page.getByLabel('Author:')
+  await expect(select).toBeVisible()
+  await expect(select).toHaveAttribute('id', 'author-select')
+  await expect(select).toHaveValue('')
+  await expect(select.getByRole('option')).toHaveCount(4)
+  await expect(select.getByRole('option', { name: 'All authors' })).toBeAttached()
+  await expect(select.getByRole('option', { name: 'Author A' })).toBeAttached()
+  await expect(select.getByRole('option', { name: 'Author B' })).toBeAttached()
+  await expect(select.getByRole('option', { name: 'Author C' })).toBeAttached()
+})
+
+test('selecting an author sends the author parameter and filters the grid', async ({
+  page,
+}) => {
+  const authorRequests: string[] = []
+  page.on('request', (req) => {
+    if (req.url().includes('openlibrary.org/search') && req.url().includes('author=')) {
+      authorRequests.push(req.url())
+    }
+  })
+
+  await setupApiMocks(page, { searchResponse: multiAuthorResponse })
+  await search(page)
+
+  await page.getByLabel('Author:').selectOption('Author A')
+
+  await expect(page.getByText('Book One')).toBeVisible()
+  await expect(page.getByText('Book Three')).toBeVisible()
+  await expect(page.getByText('Book Two')).not.toBeVisible()
+
+  expect(
+    authorRequests.some((url) => new URL(url).searchParams.get('author') === 'Author A')
+  ).toBe(true)
+})
+
+test('selecting All authors clears the filter and restores results', async ({
+  page,
+}) => {
+  await setupApiMocks(page, { searchResponse: multiAuthorResponse })
+  await search(page)
+
+  await page.getByLabel('Author:').selectOption('Author A')
+  await expect(page.getByText('Book Two')).not.toBeVisible()
+
+  await page.getByLabel('Author:').selectOption('')
+  await expect(page.getByText('Book One')).toBeVisible()
+  await expect(page.getByText('Book Two')).toBeVisible()
+  await expect(page.getByText('Book Three')).toBeVisible()
+})
+
+test('selecting an author resets Load more pagination', async ({ page }) => {
+  await setupApiMocks(page)
+  await search(page)
+
+  await page.getByRole('button', { name: 'Load more' }).click()
+  await expect(page.getByRole('listitem')).toHaveCount(5)
+  await expect(page.getByText('Showing 5 of 100 results')).toBeVisible()
+
+  await page.getByLabel('Author:').selectOption('J.R.R. Tolkien')
+  await expect(page.getByText('Showing 3 of 100 results')).toBeVisible()
+  await expect(page.getByRole('listitem')).toHaveCount(3)
+})