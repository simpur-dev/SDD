@@ -0,0 +1,54 @@
+"""Static regression checks for the author filter contract.
+
+The end-to-end behavior is covered by tests/author-filter.spec.ts. These
+checks run under pytest and guard the required public interface so the
+author filter cannot silently drift from the contract.
+"""
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+SRC = ROOT / "src"
+
+
+def read(relative_path: str) -> str:
+    return (SRC / relative_path).read_text(encoding="utf-8")
+
+
+def test_author_filter_control_contract() -> None:
+    component = read("components/AuthorFilter.tsx")
+
+    assert 'htmlFor="author-select"' in component
+    assert 'id="author-select"' in component
+    assert "Author:" in component
+    assert "All authors" in component
+    assert '<option value="">' in component
+
+
+def test_author_filter_is_wired_into_search_page() -> None:
+    page = read("pages/SearchPage.tsx")
+
+    assert "AuthorFilter" in page
+    # Authors are deduped from the docs currently returned by search.
+    assert "new Set(" in page
+    assert "author_name" in page
+    # The grid only renders books matching the selected author.
+    assert "author_name?.includes(author)" in page
+
+
+def test_search_uses_author_query_parameter_and_resets_pagination() -> None:
+    hook = read("hooks/useBookSearch.ts")
+
+    # The author is part of the query key so selecting one starts a fresh
+    # infinite query at pageParam 0 (pagination reset).
+    assert "['books', query, sort, author]" in hook
+    assert "author: author || undefined" in hook
+
+
+def test_author_state_is_stored_and_cleared() -> None:
+    store = read("store/searchStore.ts")
+
+    assert "author: string" in store
+    assert "setAuthor: (author: string) => void" in store
+    assert "author: ''" in store
+    assert "set({ query, author: '' })" in store