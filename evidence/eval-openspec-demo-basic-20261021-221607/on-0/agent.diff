@@ -0,0 +1,152 @@
+import { test, expect } from '@playwright/test'
+import { setupApiMocks } from './helpers/mockApi'
+
+test.beforeEach(async ({ page }) => {
+  await setupApiMocks(page)
+})
+
+async function searchAndWaitForResults(page: Parameters<typeof setupApiMocks>[0]) {
+  await page.goto('/')
+  await page.getByRole('searchbox').fill('tolkien')
+  await page.getByRole('button', { name: 'Search' }).click()
+  await expect(page.getByRole('list', { name: 'Search results' })).toBeVisible()
+}
+
+test('author filter hidden with no query', async ({ page }) => {
+  await page.goto('/')
+  await expect(page.getByLabel('Author:')).not.toBeVisible()
+})
+
+test('author filter lists deduped authors from current results', async ({
+  page,
+}) => {
+  await searchAndWaitForResults(page)
+
+  const select = page.getByLabel('Author:')
+  await expect(select).toBeVisible()
+  await expect(select).toHaveAttribute('id', 'author-select')
+  await expect(
+    select.getByRole('option', { name: 'All authors' }),
+  ).toBeAttached()
+  await expect(
+    select.getByRole('option', { name: 'J.R.R. Tolkien' }),
+  ).toBeAttached()
+  await expect(select.getByRole('option')).toHaveCount(2)
+})
+
+test('selecting an author sends author param and filters the grid', async ({
+  page,
+}) => {
+  await setupApiMocks(page, {
+    searchResponse: {
+      numFound: 2,
+      start: 0,
+      numFoundExact: true,
+      docs: [
+        {
+          key: '/works/OL1W',
+          title: 'Book One',
+          author_name: ['Author A'],
+          cover_i: null,
+          first_publish_year: 2000,
+        },
+        {
+          key: '/works/OL2W',
+          title: 'Book Two',
+          author_name: ['Author B'],
+          cover_i: null,
+          first_publish_year: 2001,
+        },
+      ],
+    },
+  })
+
+  const initialRequests: string[] = []
+  page.on('request', (req) => {
+    if (req.url().includes('openlibrary.org/search')) {
+      initialRequests.push(req.url())
+    }
+  })
+
+  await page.goto('/')
+  await page.getByRole('searchbox').fill('tolkien')
+  await page.getByRole('button', { name: 'Search' }).click()
+  await expect(page.getByText('Book One')).toBeVisible()
+
+  expect(initialRequests).not.toHaveLength(0)
+  expect(
+    initialRequests.every(
+      (url) => !new URL(url).searchParams.has('author'),
+    ),
+  ).toBe(true)
+
+  const authorRequest = page.waitForRequest(
+    (req) =>
+      req.url().includes('openlibrary.org/search') &&
+      new URL(req.url()).searchParams.get('author') === 'Author A',
+  )
+  await page.getByLabel('Author:').selectOption('Author A')
+  await authorRequest
+
+  await expect(page.getByText('Book One')).toBeVisible()
+  await expect(page.getByText('Book Two')).not.toBeVisible()
+})
+
+test('selecting an author resets load more pagination', async ({ page }) => {
+  await searchAndWaitForResults(page)
+
+  await page.getByRole('button', { name: 'Load more' }).click()
+  await expect(page.getByRole('listitem')).toHaveCount(5)
+
+  const authorRequest = page.waitForRequest(
+    (req) =>
+      req.url().includes('openlibrary.org/search') &&
+      new URL(req.url()).searchParams.get('author') === 'J.R.R. Tolkien',
+  )
+  await page.getByLabel('Author:').selectOption('J.R.R. Tolkien')
+  const request = await authorRequest
+
+  expect(new URL(request.url()).searchParams.get('offset')).toBe('0')
+  await expect(page.getByRole('listitem')).toHaveCount(3)
+})
+
+test('All authors clears the filter and restores all results', async ({
+  page,
+}) => {
+  await setupApiMocks(page, {
+    searchResponse: {
+      numFound: 2,
+      start: 0,
+      numFoundExact: true,
+      docs: [
+        {
+          key: '/works/OL1W',
+          title: 'Book One',
+          author_name: ['Author A'],
+          cover_i: null,
+          first_publish_year: 2000,
+        },
+        {
+          key: '/works/OL2W',
+          title: 'Book Two',
+          author_name: ['Author B'],
+          cover_i: null,
+          first_publish_year: 2001,
+        },
+      ],
+    },
+  })
+
+  await page.goto('/')
+  await page.getByRole('searchbox').fill('tolkien')
+  await page.getByRole('button', { name: 'Search' }).click()
+  await expect(page.getByText('Book One')).toBeVisible()
+
+  await page.getByLabel('Author:').selectOption('Author A')
+  await expect(page.getByText('Book Two')).not.toBeVisible()
+
+  await page.getByLabel('Author:').selectOption('')
+  await expect(page.getByText('Book One')).toBeVisible()
+  await expect(page.getByText('Book Two')).toBeVisible()
+  await expect(page.getByLabel('Author:')).toHaveValue('')
+})
