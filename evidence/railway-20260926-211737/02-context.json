      {
        "id": "CODE-12d4b7620710",
        "project_id": "railway-20260926-211737",
        "type": "code",
        "module": "publish",
        "title": "publish",
        "content": "\"\"\"发布判断：检测到冲突则阻止发布（受 RULE-3 约束）。\n\n需求依据见 REQ-3。\n\"\"\"\n\nfrom occupancy import Occupation, has_conflicts\nfrom schedule import Train, arrival_times, to_minutes\n\n\ndef windows_for(train: Train) -> list[Occupation]:\n    \"\"\"按停站时刻近似为占用区间（教学模型：站间即为占用）。\"\"\"\n    stops = train.stops()\n    times = arrival_times(train)\n    return [\n        Occupation(\n            train_id=train.train_id,\n            start_min=to_minutes(times[stops[index]]),\n            end_min=to_minutes(times[stops[index + 1]]),\n        )\n        for index in range(len(stops) - 1)\n    ]\n\n\ndef can_publish(\n    train: Train, fleet: list[Occupation]\n) -> tuple[bool, str]:\n    \"\"\"本车占用与车队既有占用冲突则禁止发布。\"\"\"\n    mine = windows_for(train)\n    if has_conflicts([*mine, *fleet]):\n        return False, \"occupied: 存在车辆占用冲突，禁止发布\"\n    return True, \"publish ok\"\n",
        "version": "0.1.0",
        "status": "active",
        "effective_from": null,
        "effective_to": null,
        "applies_to_ref": null,
        "supersedes": null,
        "superseded_by": null,
        "source": {
          "uri": "src/publish.py",
          "locator": null,
          "kind": null,
          "checksum": "sha256:71aaba2afdc5c6c03c7fe4be60f23aa95669d0de038698b4d2e784af90bd47f3"
        },
        "checksum": "sha256:71aaba2afdc5c6c03c7fe4be60f23aa95669d0de038698b4d2e784af90bd47f3",
        "tags": [
