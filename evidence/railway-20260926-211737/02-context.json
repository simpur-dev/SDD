      {
        "id": "DES-1",
        "project_id": "railway-20260926-211737",
        "type": "design",
        "module": "schedule",
        "title": "时刻计算设计",
        "content": "---\nid: DES-01\ntype: design\nmodule: schedule\nversion: 1.0.0\nstatus: active\ntitle: 时刻计算设计\n---\n\n# 时刻计算设计\n\nschedule 模块以\"始发时刻 + 站间运行时分\"推导各站时刻，实现 REQ-1。\n调整发车时间时平移始发时刻即可重算后续各站。\n",
        "version": "1.0.0",
