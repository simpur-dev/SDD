      {
        "id": "CODE-e662196c212e",
        "project_id": "railway-20260926-211737",
        "type": "code",
        "module": "api",
        "title": "api",
        "content": "\"\"\"页面/接口：选择目标站点、提交新车发时间（功能入口）。\n\n需求依据见 REQ-4。\n\"\"\"\n\nfrom publish import can_publish\nfrom schedule import Train, arrival_times\n\n\ndef show_timetable(train: Train) -> dict[str, str]:\n    \"\"\"展示各站时刻。\"\"\"\n    return arrival_times(train)\n\n\ndef submit_publish(train: Train, fleet: list) -> tuple[bool, str]:\n    \"\"\"提交发布：先经占用与发布判断。\"\"\"\n    return can_publish(train, fleet)\n",
        "version": "0.1.0",
        "status": "active",
        "effective_from": null,
        "effective_to": null,
        "applies_to_ref": null,
        "supersedes": null,
        "superseded_by": null,
        "source": {
