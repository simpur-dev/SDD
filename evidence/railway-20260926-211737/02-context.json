      {
        "id": "CODE-4bfabc68a8f6",
        "project_id": "railway-20260926-211737",
        "type": "code",
        "module": "occupancy",
        "title": "occupancy",
        "content": "\"\"\"车辆占用检查：对照车辆其他任务检查时间窗冲突。\n\n需求依据见 REQ-2。\n\"\"\"\n\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass Occupation:\n    \"\"\"一段车辆占用：车号 + 起止分钟。\"\"\"\n\n    train_id: str\n    start_min: int\n    end_min: int\n\n\ndef conflicts(left: Occupation, right: Occupation) -> bool:\n    \"\"\"同一车辆的两段占用时间窗是否重叠。\"\"\"\n    if left.train_id != right.train_id:\n        return False\n    return left.start_min < right.end_min and right.start_min < left.end_min\n\n\ndef has_conflicts(items: list[Occupation]) -> bool:\n    for index, left in enumerate(items):\n        for right in items[index + 1:]:\n            if conflicts(left, right):\n                return True\n    return False\n",
        "version": "0.1.0",
        "status": "active",
        "effective_from": null,
        "effective_to": null,
        "applies_to_ref": null,
        "supersedes": null,
        "superseded_by": null,
        "source": {
          "uri": "src/occupancy.py",
          "locator": null,
          "kind": null,
          "checksum": "sha256:240c30a7f07794f4da0e1c6dba57b14df43473af3192538fb769dfcf8ddbc5c6"
        },
        "checksum": "sha256:240c30a7f07794f4da0e1c6dba57b14df43473af3192538fb769dfcf8ddbc5c6",
        "tags": [
