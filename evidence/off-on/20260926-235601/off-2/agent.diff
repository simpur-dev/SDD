 """时刻计算：更新当前站发车时间、重算后续各站时间。
 
-需求依据见 REQ-1。
+需求依据见 REQ-01、RULE-01。
 """
 
-from dataclasses import dataclass, field
+from dataclasses import dataclass, field, replace
+
+# 最小站间隔（分钟）。
+# REQ-01 要求不低于 5 分钟，RULE-01（现行规章）要求不低于 3 分钟；
+# 两者冲突时以现行规章为准，故取 3。
+MIN_STOP_INTERVAL_MINUTES = 3
 
 
 def to_minutes(hhmm: str) -> int:
@@ -43,3 +48,33 @@ def arrival_times(train: Train) -> dict[str, str]:
         clock += minutes
         times[stops[index + 1]] = to_hhmm(clock)
     return times
+
+
+def _normalize_hhmm(hhmm: str) -> str:
+    """校验 "HH:MM" 合法性并归一化为两位格式；非法则抛 ValueError。"""
+    parts = hhmm.split(":")
+    if len(parts) != 2 or not all(part.isdigit() for part in parts):
+        raise ValueError(f"非法时刻: {hhmm!r}，应为 HH:MM")
+    hours, minutes = int(parts[0]), int(parts[1])
+    if not (0 <= hours < 24 and 0 <= minutes < 60):
+        raise ValueError(f"非法时刻: {hhmm!r}，超出 00:00-23:59")
+    return to_hhmm(hours * 60 + minutes)
+
+
+def adjust_departure(train: Train, new_start: str) -> Train:
+    """调整始发时刻，返回重算后的新车次（REQ-01）。
+
+    始发时刻平移后，各站时刻由 arrival_times 按站间运行时分重新推导，
+    后续占用窗口与发布判断也随之基于新时刻复核。
+    站间间隔不得低于 RULE-01 规定的下限，否则拒绝调整。
+    """
+    start = _normalize_hhmm(new_start)
+    short = [
+        leg for leg, minutes in train.legs.items()
+        if minutes < MIN_STOP_INTERVAL_MINUTES
+    ]
+    if short:
+        raise ValueError(
+            f"站间间隔不得低于 {MIN_STOP_INTERVAL_MINUTES} 分钟: {'、'.join(short)}"
+        )
+    return replace(train, start=start)
