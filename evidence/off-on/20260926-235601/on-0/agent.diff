diff --git a/src/schedule.py b/src/schedule.py
index 08042fc..f9c4418 100644
--- a/src/schedule.py
+++ b/src/schedule.py
@@ -3,6 +3,8 @@
 需求依据见 REQ-1。
 """
 
+from __future__ import annotations
+
 from dataclasses import dataclass, field
 
 
@@ -15,6 +17,34 @@ def to_hhmm(total: int) -> str:
     return f"{total // 60 % 24:02d}:{total % 60:02d}"
 
 
+# 相邻站最小间隔（分钟）。依据 RULE-1（现行规章，3 分钟）为准；
+# REQ-1 中的 5 分钟为过时表述，已按现行规章对齐。
+MIN_INTERVAL_MIN = 3
+
+
+def _parse_clock(value: str) -> int:
+    """解析 HH:MM 为分钟；非法时刻抛出 ValueError。"""
+    parts = value.split(":") if isinstance(value, str) else []
+    if len(parts) != 2:
+        raise ValueError(f"非法时刻: {value!r}，应为 HH:MM")
+    try:
+        hours, minutes = int(parts[0]), int(parts[1])
+    except ValueError:
+        raise ValueError(f"非法时刻: {value!r}，应为 HH:MM") from None
+    if not (0 <= hours < 24 and 0 <= minutes < 60):
+        raise ValueError(f"非法时刻: {value!r}，应在 00:00-23:59 之间")
+    return hours * 60 + minutes
+
+
+def check_intervals(train: Train) -> None:
+    """校验各站间运行时分不低于最小站间间隔（RULE-1）。"""
+    for leg, minutes in train.legs.items():
+        if minutes < MIN_INTERVAL_MIN:
+            raise ValueError(
+                f"{leg} 间隔 {minutes} 分钟，低于最小站间间隔 {MIN_INTERVAL_MIN} 分钟"
+            )
+
+
 @dataclass
 class Train:
     """一趟车：始发时刻 + 各站间运行时分（"A->B" -> 分钟）。"""
@@ -43,3 +73,15 @@ def arrival_times(train: Train) -> dict[str, str]:
         clock += minutes
         times[stops[index + 1]] = to_hhmm(clock)
     return times
+
+
+def adjust_departure(train: Train, new_start: str) -> Train:
+    """按新的始发时刻平移时刻表并重算后续各站。
+
+    - 校验新时刻与各站间间隔（RULE-1：相邻站不低于 3 分钟）；
+    - 站间运行时分不变，后续各站由 ``arrival_times`` 自动重算；
+    - 返回新的 ``Train``，不修改入参。
+    """
+    _parse_clock(new_start)
+    check_intervals(train)
+    return Train(train_id=train.train_id, start=new_start, legs=dict(train.legs))
