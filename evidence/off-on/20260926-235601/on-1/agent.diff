+
+def test_submit_adjust_departure_returns_shifted_timetable() -> None:
+    assert submit_adjust_departure(make_train(), "09:00") == {
+        "A": "09:00",
+        "B": "09:10",
+        "C": "09:25",
+    }
+
+
+def test_submit_adjust_departure_does_not_mutate_original() -> None:
+    train = make_train()
+    submit_adjust_departure(train, "09:00")
+    assert show_timetable(train)["C"] == "08:25"
+
+
+def test_chain_rechecks_occupancy_and_publish_after_adjust() -> None:
+    """调整后整车链路：占用复核 -> 发布门禁仍生效（REQ-2/REQ-3/RULE-3）。"""
+    from schedule import adjust_departure, arrival_times, to_minutes
+
+    train = make_train()
+    # 08:00 发车时 A->B 占用 [480,490)，与既有占用冲突 -> 禁止发布
+    busy = [Occupation("K1", 485, 490)]
+    assert can_publish(train, busy)[0] is False
+
+    adjusted = adjust_departure(train, "09:00")
+    assert arrival_times(adjusted)["A"] == "09:00"
+    # 平移后占用窗口避开既有任务 -> 允许发布
+    assert to_minutes(arrival_times(adjusted)["A"]) == 540
+    assert can_publish(adjusted, busy)[0] is True
