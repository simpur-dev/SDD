+def adjust_departure(train: Train, new_start: str) -> Train:
+    """调整始发时刻，返回平移后的新车次（原车次不变）。
+
+    实现 REQ-1 与 DES-1：平移始发时刻即可由 arrival_times 重算后续各站时刻，
+    站间运行时分（legs）保持不变。
+    """
+    return replace(train, start=new_start)
