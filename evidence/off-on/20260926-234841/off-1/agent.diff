+
+
+def test_adjusted_train_still_blocked_by_occupation_window() -> None:
+    # 08:00 班次占用 480-490 / 490-505，与 515-520 不冲突；
+    # 平移到 08:20 后占用 500-510 / 510-525，与既有窗口冲突。
+    original = make_train()
+    busy = [Occupation("K1", 515, 520)]
+    assert can_publish(original, busy)[0]
+
+    adjusted = adjust_departure(original, "08:20")
+    ok, reason = can_publish(adjusted, busy)
+    assert not ok
+    assert "禁止发布" in reason
