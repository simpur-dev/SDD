+def test_adjusted_train_still_blocked_by_conflict() -> None:
+    busy = [Occupation("K1", 510, 520)]
+    original = make_train()
+    # 原 08:00 发车（480-490、490-505）与 510-520 不冲突，可发布。
+    ok, reason = can_publish(original, busy)
+    assert ok, reason
+
+    # 推迟到 08:20 后占用窗口平移到 500-510、510-525，与既有占用重叠。
