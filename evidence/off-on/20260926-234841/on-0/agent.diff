diff --git a/src/schedule.py b/src/schedule.py
index 08042fc..19622ae 100644
--- a/src/schedule.py
+++ b/src/schedule.py
@@ -34,6 +34,18 @@ class Train:
         return stops
 
 
+def adjust_departure(train: Train, new_start: str) -> Train:
+    """按站调整发车时间：整体平移始发时刻，站间运行时分保持不变。
+
+    返回新的 Train，不修改入参；后续各站时刻随之整体平移。
+    """
+    return Train(
+        train_id=train.train_id,
+        start=new_start,
+        legs=dict(train.legs),
+    )
+
+
 def arrival_times(train: Train) -> dict[str, str]:
     """各站时刻 = 始发时刻 + 累计运行时分。"""
     stops = train.stops()
