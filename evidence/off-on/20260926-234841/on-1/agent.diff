+def adjust_departure(train: Train, new_start: str) -> Train:
+    """按站调整发车时间：平移始发时刻，各站间运行时分保持不变。
+
+    返回新的 Train，不修改入参（REQ-1、DES-1）。
+    """
+    return Train(
+        train_id=train.train_id,
+        start=new_start,
+        legs=dict(train.legs),
+    )
