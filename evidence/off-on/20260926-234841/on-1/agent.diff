+def test_adjusted_train_still_blocked_when_window_conflicts() -> None:
+    # 平移到 09:00 后本车占用为 540-550、550-565；
+    # 车队既有占用 555-570 与之重叠，调整不改变发布约束（REQ-2、RULE-3）。
+    adjusted = adjust_departure(make_train(), "09:00")
