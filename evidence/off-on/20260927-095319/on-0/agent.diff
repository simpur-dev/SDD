diff --git a/src/schedule.py b/src/schedule.py
index 08042fc..db93721 100644
--- a/src/schedule.py
+++ b/src/schedule.py
@@ -34,6 +34,20 @@ class Train:
         return stops
 
 
+def adjust_departure(train: Train, new_start: str) -> Train:
+    """按站点调整发车时间：平移始发时刻，返回重算后的新列车。
+
+    站间运行时分不变，故后续各站时刻由 ``arrival_times`` 自动顺延。
+    原列车对象保持不变（REQ-1、DES-1）。
+    """
+    to_minutes(new_start)  # 校验 "HH:MM" 格式，非法输入即时报错
+    return Train(
+        train_id=train.train_id,
+        start=new_start,
+        legs=dict(train.legs),
+    )
+
+
 def arrival_times(train: Train) -> dict[str, str]:
     """各站时刻 = 始发时刻 + 累计运行时分。"""
     stops = train.stops()
