# ===== SpecWeaver 部署环境变量示例 =====
# 复制为 .env 后按需修改：Copy-Item .env.example .env

# ---- 组件版本 ----
# seekdb：Docker Hub 无 1.4.0 这个 tag，请在镜像处使用 oceanbase/seekdb:latest（即 v1.4.0）
SEEKDB_VERSION=1.4.0
# PowerContext：完整功能（Source/Handoff/Skill/MCP）仅在 master 分支，用 dev 标识构建
PC_VERSION=1.2.0.dev0

# ---- 端口 ----
SEEKDB_SQL_PORT=2881
SEEKDB_HTTP_PORT=2886
PC_PORT=8000

# ---- powercontext 源码路径 ----
# WSL 路径（推荐，构建性能最佳）：
POWERCONTEXT_SRC=/opt/powercontext
# Windows 本地路径（Docker Desktop，构建较慢）示例：
# POWERCONTEXT_SRC=E:/2026ob_projects/SDD/research/powercontext

# ---- 宿主代理（WSL 脚本据此 + 动态宿主IP 配置 Docker）----
PROXY_PORT=10090

# ---- MiniMax 开放平台（赛题提供 Token 计划；填入你的 key）----
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01
# Embedding 模型（用于生成向量；如使用其他供应商请相应调整）
MINIMAX_EMBED_MODEL=embo-01
