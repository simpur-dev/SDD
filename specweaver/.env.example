# SpecWeaver 推理后端配置示例：复制为 specweaver/.env 后填入真实 key
# 变量名 = 字段路径，双下划线分隔嵌套（pydantic-settings）。

# provider: none | minimax | deepseek | qianwen
#   minimax  -> chat + embo-01 真实向量（dim 1536）
#   deepseek -> chat 真实 LLM；无 embeddings API，向量保持确定性哈希
#   qianwen  -> chat + 标准 OpenAI embeddings（text-embedding-v3/v4）
#   none     -> 全规则模式
INFERENCE__PROVIDER=none
INFERENCE__BASE_URL=https://api.deepseek.com
INFERENCE__MODEL=deepseek-chat
INFERENCE__EMBED_MODEL=text-embedding-v4
INFERENCE__DIM=1536
INFERENCE__API_KEY=

# ---- 后端与运行姿态（全部可留空，默认值与 deploy/docker-compose.yml 对齐）----
SEEKDB__HOST=127.0.0.1
SEEKDB__PORT=2881
SEEKDB__USER=root
SEEKDB__PASSWORD=
SEEKDB__DATABASE=specweaver
POWERCONTEXT__BASE_URL=http://localhost:8000
# 单机演示保持匿名；放到共享机器/局域网时，服务端设
# POWERCONTEXT_SERVER_ACCESS_MODE=enforced + POWERCONTEXT_SERVER_AUTH_TOKEN=<强随机>，
# 这里填同一个 token，客户端会带 Authorization: Bearer 发送（留空＝匿名）。
POWERCONTEXT__TOKEN=
POWERCONTEXT__TIMEOUT=20

# ---- 上下文装配 ----
# 预算按 UTF-8 字节强制（渲染后复测，超了就重裁）。规模成本的主要项是 validity
# 对项目内每条需求的图核对，不只由 n_results 决定，见 docs/01 §11 的受控扫描。
CONTEXT__BUDGET_BYTES=8000
CONTEXT__N_RESULTS=20

# ---- 工作区（测试命令由调用方逐次传入：CLI --test-command / sw_complete_task）----
WORKSPACE__ROOT=.

# ---- streamable-http 传输（同端口 GET /metrics 出 Prometheus 文本）----
# stdio 传输用 `python -m specweaver.adapters.driving.mcp.run_stdio`，由入口决定传输，
# 没有额外的开关。
SERVER__HOST=127.0.0.1
SERVER__PORT=8765
